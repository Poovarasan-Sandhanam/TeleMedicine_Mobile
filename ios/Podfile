# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TeleMedicine_Mobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'TeleMedicine_MobileTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 rejects deployment targets below 15.0. Some pods still declare
    # much older minimums (9.0, 13.4), so raise anything below the RN minimum.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || current.to_f < 15.1
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end

    # React Native generates this phase as `/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT"`,
    # which splits both paths on spaces - and with-environment.sh then runs its
    # argument unquoted as well. From a path such as "/Volumes/Extreme SSD/..." the
    # build failed with "/bin/sh: /Volumes/Extreme: No such file or directory".
    # Load the environment into the phase and run the script with a quoted path.
    broken = '/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT_PHASES_SCRIPT"'
    fixed = ". \"$WITH_ENVIRONMENT\"\n/bin/sh \"$SCRIPT_PHASES_SCRIPT\""
    installer.pods_project.targets.each do |target|
      target.shell_script_build_phases.each do |phase|
        next unless phase.shell_script.include?(broken)
        phase.shell_script = phase.shell_script.sub(broken, fixed)
      end
    end
  end
end
